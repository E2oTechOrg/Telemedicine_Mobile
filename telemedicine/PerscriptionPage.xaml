<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:telemedicine.Components"
             x:Class="telemedicine.PerscriptionPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FBF3F8"
             Title="PerscriptionPage">

    <!-- STYLES -->
    <ContentPage.Resources>

        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Cambria"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Cambria"/>
        </Style>

        <Style TargetType="Entry">
            <Setter Property="FontFamily" Value="Cambria"/>
            <Setter Property="TextColor" Value="#111827"/>
            <Setter Property="PlaceholderColor" Value="#9CA3AF"/>
        </Style>

    </ContentPage.Resources>

    <Grid>

        <Grid RowDefinitions="*,Auto">

            <!-- MAIN CONTENT -->
            <Grid Grid.Row="0">

                <!-- SCROLL CONTENT -->
                <ScrollView>

                    <VerticalStackLayout Padding="20,55,20,120"
                                     Spacing="18">

                        <!-- TOP HEADER -->
                        <Grid ColumnDefinitions="*,Auto">

                            <!-- TITLE -->
                            <VerticalStackLayout Spacing="2">

                                <Label Text="Prescriptions"
                                   FontSize="32"
                                   FontAttributes="Bold"
                                   TextColor="#111827"/>

                                <Label Text="Manage patient prescriptions"
                                   FontSize="15"
                                   TextColor="#6B7280"/>

                            </VerticalStackLayout>

                            <!-- TOTAL -->
                            <Frame Grid.Column="1"
                               BackgroundColor="#7A2257"
                               CornerRadius="16"
                               Padding="16,10"
                               HasShadow="False"
                               VerticalOptions="Center">

                                <VerticalStackLayout Spacing="0">

                                    <Label x:Name="PrescriptionCountLabel"
       Text="0"
       FontSize="20"
       FontAttributes="Bold"
       TextColor="White"
       HorizontalTextAlignment="Center"/>

                                    <Label Text="Medicines"
                                       FontSize="11"
                                       TextColor="#F5E6EF"
                                       HorizontalTextAlignment="Center"/>

                                </VerticalStackLayout>

                            </Frame>

                        </Grid>

                        <!-- SEARCH -->
                        <Frame BackgroundColor="White"
                           CornerRadius="18"
                           Padding="15,8"
                           BorderColor="#E6C3D9"
                           HasShadow="True"
                           Shadow="{Shadow Brush=#E3B9D3,
                                            Offset='0,3',
                                            Radius=8,
                                            Opacity=0.12}">

                            <Grid ColumnDefinitions="Auto,*">

                                <Image Source="search.png"
           WidthRequest="20"
           HeightRequest="20"
           Opacity="0.7"/>

                                <Entry Grid.Column="1"
           x:Name="SearchEntry"
           Placeholder="Search Prescription..."
           BackgroundColor="Transparent"
           Margin="10,0,0,0"
           FontSize="16"
           TextChanged="SearchPrescription_TextChanged"/>

                            </Grid>

                        </Frame>

                        <!-- SECTION HEADER -->
                        <Grid ColumnDefinitions="*,Auto">

                            <Label Text="Prescription List"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#111827"/>

                        </Grid>

                        <CollectionView x:Name="PrescriptionCollection"
                SelectionMode="None">

                            <CollectionView.ItemTemplate>

                                <DataTemplate>

                                    <Frame Margin="0,0,0,15"
                   Padding="16"
                   CornerRadius="22"
                   BorderColor="#E6C3D9"
                   BackgroundColor="White"
                   HasShadow="True"
                   Shadow="{Shadow Brush=#E3B9D3,
                                    Offset='0,3',
                                    Radius=8,
                                    Opacity=0.12}">

                                        <Grid ColumnDefinitions="70,*,95"
                      ColumnSpacing="14">

                                            <!-- LEFT ID -->
                                            <Frame WidthRequest="60"
                           HeightRequest="60"
                           CornerRadius="30"
                           BackgroundColor="#7A2257"
                           Padding="0"
                           HasShadow="False"
                           VerticalOptions="Center">

                                                <VerticalStackLayout
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="0">

                                                    <Label Text="ID"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"/>

                                                    <Label Text="{Binding PrescriptionId}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center"/>

                                                </VerticalStackLayout>

                                            </Frame>

                                            <!-- CENTER CONTENT -->
                                            <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="5">

                                                <Label Text="{Binding PatientName}"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="#111827"
                               LineBreakMode="TailTruncation"/>

                                                <Label Text="{Binding FirstPoint}"
                               FontSize="13"
                               TextColor="#6B7280"
                               MaxLines="2"
                               LineBreakMode="TailTruncation"/>

                                            </VerticalStackLayout>

                                            <!-- RIGHT SIDE -->
                                            <Grid Grid.Column="2"
      RowDefinitions="Auto,Auto"
      RowSpacing="10"
      WidthRequest="170"
      VerticalOptions="Center">

                                                <!-- DATE -->
                                                <Label Grid.Row="0"
           Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}"
           FontSize="12"
           FontAttributes="Bold"
           TextColor="#7A2257"
           HorizontalOptions="Center"
           HorizontalTextAlignment="Center"/>

                                                <!-- BUTTONS -->
                                                <Grid Grid.Row="1"
      RowDefinitions="Auto,Auto"
      RowSpacing="8"
      VerticalOptions="Center">

                                                    <Button Grid.Row="0"
            Text="Edit"
            HeightRequest="42"
            WidthRequest="90"
            CornerRadius="21"
            FontSize="13"
            FontAttributes="Bold"
            BackgroundColor="#FFF3E0"
            TextColor="#F57C00"
            CommandParameter="{Binding .}"
            Clicked="EditPrescriptionClicked"/>

                                                    <Button Grid.Row="1"
            Text="Share"
            HeightRequest="42"
            WidthRequest="90"
            CornerRadius="21"
            FontSize="13"
            FontAttributes="Bold"
            BackgroundColor="#16A34A"
            TextColor="White"
            CommandParameter="{Binding .}"
            Clicked="SharePrescriptionClicked"/>

                                                </Grid>

                                            </Grid>

                                        </Grid>

                                    </Frame>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>
                    </VerticalStackLayout>

                </ScrollView>

                <!-- FLOATING BUTTON -->
                <Button
    WidthRequest="58"
    HeightRequest="58"
    CornerRadius="29"
    BackgroundColor="#7A2257"
    HorizontalOptions="End"
    VerticalOptions="End"
    Margin="0,0,20,25"
    Clicked="GotoAddPrescription"
    ImageSource="adddoc.png">

                    <Button.Shadow>
                        <Shadow
            Brush="#E3B9D3"
            Offset="0,6"
            Radius="16"
            Opacity="0.45" />
                    </Button.Shadow>

                </Button>

            </Grid>

            <!-- FOOTER -->
            <components:FooterView  x:Name="Footer" Grid.Row="1"/>

        </Grid>

        <Grid x:Name="LoadingOverlay"
IsVisible="False"
BackgroundColor="#804E1638"
ZIndex="999">

            <ActivityIndicator
  IsRunning="True"
  Color="White"
  WidthRequest="48"
  HeightRequest="48"
  HorizontalOptions="Center"
  VerticalOptions="Center" />
        </Grid>

    </Grid>

</ContentPage>
